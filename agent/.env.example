# ==============================================================================
# BENTOFOCUS AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Telegram Bot (create one via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_bot_father_token_here"
# Your numeric Telegram user ID (send /start to your bot to see it).
# SECURITY: When set to 0, all commands except /start are blocked until configured.
TELEGRAM_ALLOWED_USER_ID=0

# 2. Google Gemini API (get a key at aistudio.google.com)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash"

# 3. GitHub (Personal Access Token for reading target repo PRs/issues in the digest)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=""
GITHUB_USERNAME="your-github-username"
GITHUB_TARGET_REPO="owner/repo"

# 4. E-mail (IMAP for morning unread email digest)
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
IMAP_HOST="imap.gmail.com"
IMAP_PORT=993
IMAP_USER=""
IMAP_PASSWORD=""

# 5. Shared Database (Turso / libSQL - turso.tech)
# Leave blank to use a local SQLite database for testing
TURSO_URL=""
TURSO_TOKEN=""

# 6. Daily morning digest schedule (America/Sao_Paulo)
DIGEST_HOUR=8
DIGEST_MINUTE=0
