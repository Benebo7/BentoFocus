# Template systemd unit file.
# agent/deploy/setup_azure.sh generates /etc/systemd/system/bentofocus-agent.service
# with the real user and repository paths automatically.
[Unit]
Description=BentoFocus Telegram Agent
After=network.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/agent/.venv/bin/python -m agent.main
Restart=always
RestartSec=5
EnvironmentFile=@ROOT@/agent/.env

[Install]
WantedBy=multi-user.target
